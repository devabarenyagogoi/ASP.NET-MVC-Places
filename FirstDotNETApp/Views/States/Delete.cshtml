@model FirstDotNETApp.ViewModels.StateViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<div class="card-custom">
    <h4 class="text-danger">Delete State</h4>
    <p>Are you sure you want to delete this state?</p>

    <hr />

    <dl class="row mb-0">
        <dt class="col-sm-3">
            State Name
        </dt>
        <dd class="col-sm-9">
            @Model.StateName
        </dd>

        <dt class="col-sm-3">
            Country Name
        </dt>
        <dd class="col-sm-9">
            @Model.CountryName
        </dd>
    </dl>

    <hr />

    <form asp-action="Delete">
        <input type="hidden" asp-for="StateId" />

        <div class="d-flex gap-2">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>