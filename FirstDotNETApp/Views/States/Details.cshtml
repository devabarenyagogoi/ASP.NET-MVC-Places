@model FirstDotNETApp.ViewModels.StateViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class="card-custom">
    <h4>State</h4>
    <hr />

    <dl class="row mb-0">
        <dt class="col-sm-3">
            State ID
        </dt>
        <dd class="col-sm-9">
            @Model.StateId
        </dd>

        <dt class="col-sm-3">
            State Name
        </dt>
        <dd class="col-sm-9">
            @Model.StateName
        </dd>

        <dt class="col-sm-3">
            Country Name
        </dt>
        <dd class="col-sm-9">
            @Model.CountryName
        </dd>
    </dl>

    <hr />

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.StateId" class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>
    </div>
</div>